{erl_opts, [debug_info, warnings_as_errors]}.

%% Views over barrel_docdb with guest maps run by erlang_wasm (OTP 29).
%% Kept out of the default build: opt in with `rebar3 as design compile'.
%% rocksdb is used directly for the derived index store, as barrel_docdb's
%% own store does.
{deps, [
    %% read_feed/3, store_env/1 and registered BQL sources
    {barrel_docdb, ">= 3.3.0"},
    {wasm, "0.13.0", {pkg, erlang_wasm}},
    {rocksdb, "3.2.1"}
]}.

{project_plugins, [{rebar3_hex, "7.2.0"}, rebar3_ex_doc]}.

{eunit_opts, [verbose]}.
{cover_enabled, true}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used
]}.

{dialyzer, [
    {plt_extra_apps, [barrel_docdb, wasm, rocksdb]}
]}.

{profiles, [
    {test, [{deps, [{meck, "1.2.0"}]}]}
]}.

{hex, [{doc, ex_doc}]}.
