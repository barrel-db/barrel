{application, barrel_ngram, [
    {description, "Trigram substring and regex index over barrel_docdb documents"},
    {vsn, "0.8.0"},
    {registered, [barrel_ngram_sup, barrel_ngram_registry]},
    {mod, {barrel_ngram_app, []}},
    {applications, [
        kernel,
        stdlib,
        barrel_docdb
    ]},
    {env, [
        {data_dir, "data/barrel_ngram"}
    ]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {doc, "https://docs.barrel-db.eu/ngram"},
    {links, [
        {"GitHub", "https://github.com/barrel-db/barrel"}
    ]},
    %% the NIF is built from c_src (vendored CRoaring) via do_cmake.sh; the
    %% default hex file set omits the root script, so list the build
    %% inputs explicitly -- same pattern as barrel_vectordb/barrel_faiss
    {files, [
        "src",
        "c_src",
        "do_cmake.sh",
        "rebar.config",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ]}
]}.
