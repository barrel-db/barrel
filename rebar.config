%%% Barrel umbrella build.
%%%
%%% This is a rebar3 umbrella project. Each application under apps/ keeps its
%%% own rebar.config (erl_opts, NIF build hooks, xref, dialyzer, profiles); the
%%% external dependencies they declare are aggregated here at build time, so
%%% there is no top-level {deps, ...} block.
%%%
%%% Default build: barrel_docdb, barrel_vectordb, barrel_embed, barrel_rerank.
%%% barrel_faiss is excluded by default because it needs the FAISS C++ library;
%%% opt it in with `rebar3 as faiss compile`.

%% Restrict the default app set so a plain `rebar3 compile` never requires the
%% FAISS C++ toolchain. The `faiss` profile below adds barrel_faiss back.
{project_app_dirs, [
    "apps/barrel_crypto",
    "apps/barrel_docdb",
    "apps/barrel_ngram",
    "apps/barrel_vectordb",
    "apps/barrel_embed",
    "apps/barrel_rerank",
    "apps/barrel",
    "apps/barrel_spaces"
]}.

%% Some dependencies (instrument and its hackney dep) still use the prefix
%% `catch' operator, deprecated on OTP 29. Scope the suppression to them so the
%% umbrella's own code stays strict.
{overrides, [
    {add, instrument, [{erl_opts, [nowarn_deprecated_catch]}]},
    {add, hackney, [{erl_opts, [nowarn_deprecated_catch]}]}
]}.

{project_plugins, [
    rebar3_hex,
    rebar3_ex_doc
]}.

%% Development shell starts the two primary databases.
{shell, [
    {apps, [barrel_docdb, barrel_vectordb]}
]}.

{eunit_opts, [verbose]}.
{cover_enabled, true}.
{ct_opts, [{verbose, true}]}.

%% Umbrella-level xref: same checks as every app (no exports_not_used:
%% the whole umbrella is a library surface). Without this, rebar3 falls
%% back to its built-in default at the root, which flags every export.
%% CI runs per-leaf xref with each app's own config and ignores.
{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used
]}.
{xref_ignores, [
    %% yecc emits return_error/2 for grammar action code to call
    {barrel_bql_parser, return_error, 2}
]}.

%% Umbrella-level dialyzer: without this, `rebar3 dialyzer` at the root
%% ignores every leaf app's own `plt_extra_apps` (ONLY applied when
%% dialyzer runs inside that app's own directory), so a call into an
%% external dep that isn't a project app -- mimerl (barrel_docdb),
%% iommap/hackney (barrel_vectordb) -- shows up as an
%% "Unknown function" false positive instead of being resolved against
%% the dep's real PLT entry. Scoped to deps of apps always in the
%% default `project_app_dirs' set; profile-gated apps (barrel_faiss,
%% barrel_att_s3) keep resolving their own extra deps via their own
%% `rebar.config' when dialyzed from inside their own directory.
{dialyzer, [
    {plt_extra_apps, [mimerl, rocksdb, public_key, inets, iommap,
                      hackney]}
]}.

{profiles, [
    {test, [
        {deps, [{meck, "1.2.0"}]}
    ]},
    %% Opt the FAISS app into the build. Requires the FAISS C++ library.
    %%   rebar3 as faiss compile
    {faiss, [
        {project_app_dirs, [
            "apps/barrel_crypto",
            "apps/barrel_docdb",
            "apps/barrel_vectordb",
            "apps/barrel_embed",
            "apps/barrel_rerank",
            "apps/barrel",
            "apps/barrel_spaces",
            "apps/barrel_faiss"
        ]}
    ]},
    %% Opt the network server into the build. Pulls livery and its transports;
    %% kept out of the default (embeddable) build.
    %%   rebar3 as server compile | rebar3 as server shell
    {server, [
        {project_app_dirs, [
            "apps/barrel_crypto",
            "apps/barrel_docdb",
            "apps/barrel_ngram",
            "apps/barrel_vectordb",
            "apps/barrel_embed",
            "apps/barrel_rerank",
            "apps/barrel",
            "apps/barrel_spaces",
            "apps/barrel_server"
        ]},
        {shell, [
            {apps, [barrel_server]}
        ]},
        {relx, [
            {release, {barrel_server, "1.5.0"}, [
                barrel_server,
                sasl,
                runtime_tools,
                instrument
            ]},
            {dev_mode, true},
            {include_erts, false},
            {extended_start_script, true}
        ]}
    ]},
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true}
        ]}
    ]},
    %% Opt the S3 attachment backend into the build. Pulls livery_s3 (and
    %% livery); kept out of the default (embeddable) build.
    %%   rebar3 as s3 compile
    {s3, [
        {project_app_dirs, [
            "apps/barrel_crypto",
            "apps/barrel_docdb",
            "apps/barrel_ngram",
            "apps/barrel_vectordb",
            "apps/barrel_embed",
            "apps/barrel_rerank",
            "apps/barrel",
            "apps/barrel_spaces",
            "apps/barrel_att_s3"
        ]}
    ]},
    %% Combined S3-backend + network-server release, used only by the S3
    %% attachment-backend e2e fixture (test/e2e/attachments-s3.sh) and its
    %% CI job. relx release definitions don't merge across profiles (each
    %% `relx` stanza fully replaces the prior one on `as s3,server`), so
    %% this profile declares the release explicitly rather than combining
    %% `s3` and `server`.
    %%   rebar3 as s3_server,prod release -n barrel_server
    {s3_server, [
        {project_app_dirs, [
            "apps/barrel_crypto",
            "apps/barrel_docdb",
            "apps/barrel_ngram",
            "apps/barrel_vectordb",
            "apps/barrel_embed",
            "apps/barrel_rerank",
            "apps/barrel",
            "apps/barrel_spaces",
            "apps/barrel_server",
            "apps/barrel_att_s3"
        ]},
        {shell, [
            {apps, [barrel_server]}
        ]},
        {relx, [
            {release, {barrel_server, "1.5.0"}, [
                barrel_server,
                barrel_att_s3,
                sasl,
                runtime_tools,
                instrument
            ]},
            {dev_mode, true},
            {include_erts, false},
            {extended_start_script, true}
        ]}
    ]}
]}.

%% Umbrella release skeleton. The primary deliverables are `rebar3 compile` and
%% the test suites; release assembly can be refined in a later change.
{relx, [
    {release, {barrel, "1.3.1"}, [
        barrel_crypto,
        barrel_docdb,
        barrel_vectordb,
        barrel_embed,
        barrel_rerank,
        barrel,
        barrel_spaces,
        sasl,
        runtime_tools,
        instrument
    ]},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true},
    {sys_config, "rel/sys.config"},
    {vm_args, "rel/vm.args"}
]}.
